# Maintainer: Cyril Wolfangel <cyril.wolfangel@gmail.com>
#
# Do not edit pkgver or sha256sums by hand — run, from the repository root:
#   ./packaging/update-aur.sh 0.2.0
# It rewrites both this file and .SRCINFO from the published git tag.

pkgname=lazycam
pkgver=0.2.1
pkgrel=1
pkgdesc="One-key screen recorder for GNOME on Wayland: press Super+R, it records screen and voice; press again, it is edited"
arch=('any')
url="https://github.com/friteuseb/lazycam"
license=('GPL-3.0-or-later')
depends=('bash'
         'python'
         'python-gobject'
         'gtk4'
         'libadwaita'
         'jq'
         'ffmpeg'
         'pipewire'
         'wireplumber'
         'libnotify'
         'glib2'
         'gpu-screen-recorder')
optdepends=('showmethekey: on-screen overlay of the keys you press while recording')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('d08110052582b074c72b66243b7a9e38f319d6bd69405ec6a9dd673fb237a9b5')

package() {
    cd "$srcdir/$pkgname-$pkgver"

    install -Dm755 -t "$pkgdir/usr/bin" bin/*
    install -Dm755 packaging/lazycam-config "$pkgdir/usr/bin/lazycam-config"

    install -Dm644 -t "$pkgdir/usr/share/lazycam" gui/*.py

    install -Dm644 data/org.friteuseb.lazycam.desktop \
        "$pkgdir/usr/share/applications/org.friteuseb.lazycam.desktop"
    install -Dm644 data/icon.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.friteuseb.lazycam.svg"

    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE   "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
